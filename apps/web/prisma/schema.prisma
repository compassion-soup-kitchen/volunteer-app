generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth & Roles ─────────────────────────────────────

enum Role {
  PUBLIC
  VOLUNTEER
  COORDINATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  ARCHIVED
}

model User {
  id             String     @id @default(cuid())
  name           String?
  email          String     @unique
  emailVerified  DateTime?
  image          String?
  password       String?
  role           Role       @default(PUBLIC)
  status         UserStatus @default(ACTIVE)
  archivedAt     DateTime?
  archivedReason String?
  archivedById   String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  accounts Account[]
  sessions Session[]

  volunteerProfile     VolunteerProfile?
  reviewedApplications Application[]        @relation("ReviewedBy")
  createdShifts        Shift[]
  markedAttendance     ShiftSignup[]        @relation("AttendanceMarkedBy")
  recordedShiftMeals   Shift[]              @relation("MealsRecordedBy")
  createdTraining      TrainingSession[]
  createdAnnouncements Announcement[]
  createdEvents        Event[]
  eventRsvps           EventRsvp[]
  uploadedDocuments    Document[]           @relation("UploadedBy")
  updatedAgreements    AgreementTemplate[]  @relation("AgreementTemplateUpdatedBy")
  reAckSetAgreements   AgreementTemplate[]  @relation("AgreementTemplateReAckSetBy")
  archivedBy           User?                @relation("UserArchivedBy", fields: [archivedById], references: [id])
  archivedUsers        User[]               @relation("UserArchivedBy")
  pushTokens           PushToken[]
  impersonationsMade   ImpersonationEvent[] @relation("ImpersonationImpersonator")
  impersonationsOf     ImpersonationEvent[] @relation("ImpersonationTarget")
}

// Audit trail for admin impersonation. One row per "become another user"
// session: `startedAt` on start, `endedAt` filled when the admin returns to
// their own account (null while an impersonation is still active). Kept for
// accountability - who viewed the app as whom, and for how long.
model ImpersonationEvent {
  id             String    @id @default(cuid())
  impersonatorId String
  targetUserId   String
  startedAt      DateTime  @default(now())
  endedAt        DateTime?

  impersonator User @relation("ImpersonationImpersonator", fields: [impersonatorId], references: [id], onDelete: Cascade)
  target       User @relation("ImpersonationTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([impersonatorId])
  @@index([targetUserId])
}

enum Platform {
  IOS
  ANDROID
}

// A mobile device registered for Expo push notifications. One row per
// device; the token moves to whichever user last signed in on that device.
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  Platform
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Volunteer Onboarding ─────────────────────────────

enum VolunteerStatus {
  APPLICATION_SUBMITTED
  AWAITING_VETTING
  APPROVED_FOR_INDUCTION
  ACTIVE
  INACTIVE
}

enum MojStatus {
  NOT_STARTED
  SUBMITTED
  CLEARED
  FLAGGED
}

model VolunteerProfile {
  id                           String          @id @default(cuid())
  userId                       String          @unique
  phone                        String?
  address                      String?
  dateOfBirth                  DateTime?
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?
  bio                          String?
  availability                 Json?
  skills                       String[]
  status                       VolunteerStatus @default(APPLICATION_SUBMITTED)
  mojStatus                    MojStatus       @default(NOT_STARTED)
  createdAt                    DateTime        @default(now())
  updatedAt                    DateTime        @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  interests           ServiceArea[]        @relation("VolunteerInterests")
  groups              VolunteerGroup[]     @relation("VolunteerGroupMembers")
  applications        Application[]
  documents           Document[]
  signedAgreements    SignedAgreement[]
  shiftSignups        ShiftSignup[]
  shiftOffers         ShiftOffer[]
  trainingAttendances TrainingAttendance[]
}

/// The colour a group's badge carries. Stored as intent, not hex - each maps to
/// a shared badge variant so groups stay inside the theme in both light and dark.
enum GroupTone {
  BRAND
  INFO
  SUCCESS
  WARNING
  NEUTRAL
}

/// A named crew inside the wider whānau - Team Leaders, Guardian Angels, the
/// Thursday regulars. Membership is many-to-many and purely descriptive: it
/// grants no access at all (that is `User.role`), it just makes who's who
/// legible on the roster, in the directory, and to volunteers themselves.
///
/// `visibleToVolunteers` decides whether the group shows outside the staff
/// side. Groups volunteers should be able to turn to - team leaders, guardian
/// angels - are visible; a private coordination list can be kept staff-only.
model VolunteerGroup {
  id                  String    @id @default(cuid())
  /// What staff typed, shown everywhere.
  name                String    @unique
  /// `name` lowercased. Postgres unique indexes are case-sensitive, so without
  /// this two coordinators saving "Team Leaders" and "team leaders" at the same
  /// moment would both clear the application-level check and land side by side.
  /// Written from `name` on every save - never edited directly.
  nameKey             String    @unique
  description         String?
  tone                GroupTone @default(NEUTRAL)
  visibleToVolunteers Boolean   @default(true)
  isArchived          Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  members VolunteerProfile[] @relation("VolunteerGroupMembers")
}

enum ApplicationStatus {
  PENDING
  APPROVED
  DECLINED
  INFO_REQUESTED
}

model Application {
  id           String            @id @default(cuid())
  volunteerId  String
  status       ApplicationStatus @default(PENDING)
  notes        String?
  submittedAt  DateTime          @default(now())
  reviewedAt   DateTime?
  reviewedById String?

  volunteer  VolunteerProfile @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  reviewedBy User?            @relation("ReviewedBy", fields: [reviewedById], references: [id])
}

enum DocumentType {
  ID
  MOJ_FORM
  SIGNED_AGREEMENT
  POLICY
  TRAINING_MATERIAL
}

model Document {
  id           String       @id @default(cuid())
  volunteerId  String?
  type         DocumentType
  fileName     String
  fileUrl      String
  uploadedAt   DateTime     @default(now())
  uploadedById String?

  volunteer  VolunteerProfile? @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  uploadedBy User?             @relation("UploadedBy", fields: [uploadedById], references: [id])
}

model SignedAgreement {
  id              String   @id @default(cuid())
  volunteerId     String
  /// Matches AgreementTemplate.agreementType. Deliberately not a foreign key:
  /// an acknowledgement is a record of what someone agreed to on the day, and
  /// it has to outlive the template being retired or renamed.
  agreementType   String
  /// Null when the template only asks for a tick, not a drawn signature.
  signatureData   String?  @db.Text
  signedAt        DateTime @default(now())
  documentVersion String?

  volunteer VolunteerProfile @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
}

model AgreementTemplate {
  id                String    @id @default(cuid())
  /// Stable key, generated from the title when staff add an agreement. It is
  /// what SignedAgreement points at and what appears in the staff URL, so it
  /// never changes once created - renaming the title leaves it alone.
  agreementType     String    @unique
  title             String
  content           String    @db.Text
  version           String    @default("1.0")
  /// Every agreement is acknowledged with a tick. This adds a drawn signature
  /// on top, for the ones that want stronger evidence than a checkbox.
  requiresSignature Boolean   @default(true)
  /// Retired agreements drop off the volunteer list and stop counting towards
  /// outstanding acknowledgements, but the signatures against them survive.
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  updatedById       String?
  requiresReAck     Boolean   @default(false)
  reAckSetAt        DateTime?
  reAckSetById      String?

  updatedBy  User? @relation("AgreementTemplateUpdatedBy", fields: [updatedById], references: [id])
  reAckSetBy User? @relation("AgreementTemplateReAckSetBy", fields: [reAckSetById], references: [id])
}

// ─── Operations ───────────────────────────────────────

model ServiceArea {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())

  shifts     Shift[]
  volunteers VolunteerProfile[] @relation("VolunteerInterests")
}

model Shift {
  id                String    @id @default(cuid())
  serviceAreaId     String
  date              DateTime  @db.Date
  startTime         String
  endTime           String
  capacity          Int
  notes             String?
  /// Nullable so the roster outlives the coordinator who wrote it: a shift
  /// that happened still happened once their account is erased. See the note
  /// on `Announcement.createdById`.
  createdById       String?
  createdAt         DateTime  @default(now())
  mealsServed       Int?
  mealsRecordedAt   DateTime?
  mealsRecordedById String?
  // Right of first refusal: while this day has not passed and someone still
  // has a pending offer, only the volunteers offered the shift can take it.
  offersCloseOn     DateTime? @db.Date

  serviceArea     ServiceArea   @relation(fields: [serviceAreaId], references: [id])
  createdBy       User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  mealsRecordedBy User?         @relation("MealsRecordedBy", fields: [mealsRecordedById], references: [id])
  signups         ShiftSignup[]
  offers          ShiftOffer[]
}

enum ShiftOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// A shift held for a regular before it opens to everyone — the established
/// crew gets first refusal, and declining releases the spot early.
model ShiftOffer {
  id          String           @id @default(cuid())
  shiftId     String
  volunteerId String
  status      ShiftOfferStatus @default(PENDING)
  offeredAt   DateTime         @default(now())
  respondedAt DateTime?

  shift     Shift            @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  volunteer VolunteerProfile @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@unique([shiftId, volunteerId])
  @@index([volunteerId, status])
}

enum SignupStatus {
  SIGNED_UP
  ATTENDED
  NO_SHOW
  CANCELLED
}

model ShiftSignup {
  id                   String       @id @default(cuid())
  shiftId              String
  volunteerId          String
  status               SignupStatus @default(SIGNED_UP)
  signedUpAt           DateTime     @default(now())
  attendanceMarkedById String?
  attendanceMarkedAt   DateTime?

  shift              Shift            @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  volunteer          VolunteerProfile @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  attendanceMarkedBy User?            @relation("AttendanceMarkedBy", fields: [attendanceMarkedById], references: [id])

  @@unique([shiftId, volunteerId])
}

/// A kind of training the kitchen runs. This was a fixed enum; staff now add
/// and rename their own from /staff/training/types.
///
/// `key` is the stable identifier the mobile app and the /api/v1 wire format
/// match on (see apps/mobile/src/lib/training.ts, which treats INDUCTION,
/// HEALTH_SAFETY and DE_ESCALATION as core). It is generated from the name at
/// creation and never changes afterwards, so renaming a type is safe.
model TrainingType {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String   @unique
  description String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())

  sessions TrainingSession[]
}

model TrainingSession {
  id          String   @id @default(cuid())
  typeId      String
  title       String
  description String?
  date        DateTime @db.Date
  startTime   String
  endTime     String
  capacity    Int
  location    String?
  /// Nullable for the same reason as `Announcement.createdById`.
  createdById String?
  createdAt   DateTime @default(now())

  type        TrainingType         @relation(fields: [typeId], references: [id])
  createdBy   User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  attendances TrainingAttendance[]

  @@index([typeId])
}

enum AttendanceStatus {
  REGISTERED
  ATTENDED
  NO_SHOW
  CANCELLED
}

model TrainingAttendance {
  id          String           @id @default(cuid())
  sessionId   String
  volunteerId String
  status      AttendanceStatus @default(REGISTERED)

  session   TrainingSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  volunteer VolunteerProfile @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@unique([sessionId, volunteerId])
}

// ─── Communication ────────────────────────────────────

enum Audience {
  ALL
  VOLUNTEERS
  COORDINATORS
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String    @db.Text
  audience    Audience  @default(ALL)
  /// Nullable so a pānui outlives its author. Anyone may erase their account
  /// (the App Store requires it, and so does the Privacy Act), but a message
  /// that was sent stays sent - the same reasoning as `eventId` below. The
  /// author's name simply drops off; the pānui itself is org history.
  createdById String?
  createdAt   DateTime  @default(now())
  sentAt      DateTime?
  /// The gathering this pānui is about, when it is announcing one. Optional
  /// both ways: most pānui announce nothing, and an event can be announced
  /// more than once (the invitation, then "replies close Friday").
  eventId     String?

  createdBy   User?                    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  event       Event?                   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  attachments AnnouncementAttachment[]

  @@index([eventId])
}

/// A file rider on a pānui — a roster PDF, a flyer, a menu.
///
/// Deliberately separate from `Document`: those are org-wide policies and
/// per-volunteer records with their own retention and visibility rules, while
/// these live and die with the announcement they hang off (hence the cascade).
/// `fileUrl` holds the storage key, not a URL — reads go through a signed URL.
model AnnouncementAttachment {
  id             String   @id @default(cuid())
  announcementId String
  fileName       String
  fileUrl        String
  contentType    String
  fileSize       Int
  uploadedAt     DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([announcementId])
}

// ─── Events & RSVPs ───────────────────────────────────

enum EventStatus {
  DRAFT
  PUBLISHED
  /// Called off. Kept rather than deleted so everyone who replied can be told,
  /// and so last year's party is still in the record.
  CANCELLED
}

/// A gathering the whānau is invited to — the Christmas party, a volunteer hui,
/// a working bee.
///
/// Deliberately not a `Shift`: nobody is rostered, there is no service area and
/// no meal count, and staff come as guests rather than as coordinators.
/// Deliberately not an `Announcement` either — a pānui is one message sent once,
/// while an event has a life of its own: it can be announced several times,
/// edited long after the first pānui went out, cancelled without losing its
/// guest list, and it must outlive any single message about it.
model Event {
  id           String      @id @default(cuid())
  title        String
  description  String?     @db.Text
  /// A wall-calendar day like `Shift.date` (see date-only.ts). Times are "HH:mm"
  /// strings, so the same helpers format events, shifts and training alike.
  date         DateTime    @db.Date
  startTime    String?
  endTime      String?
  location     String?
  /// Who is invited, and therefore who may reply. Shares the `Audience` enum
  /// with announcements so "everyone" means the same thing on both.
  audience     Audience    @default(ALL)
  status       EventStatus @default(DRAFT)
  /// Whether replies are being collected. Off for a save-the-date.
  rsvpEnabled  Boolean     @default(true)
  /// Last calendar day to reply. Null means right up until the event itself.
  rsvpDeadline DateTime?   @db.Date
  /// Nullable for the same reason as `Announcement.createdById`.
  createdById  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  createdBy     User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  rsvps         EventRsvp[]
  announcements Announcement[]

  @@index([date])
  @@index([status])
}

enum RsvpResponse {
  GOING
  MAYBE
  NOT_GOING
}

/// One person's reply to an event.
///
/// Keyed by `User` rather than `VolunteerProfile` because staff attend these
/// too, and coordinators have no volunteer profile. One row per person per
/// event, so changing your mind updates the row: the tallies can never
/// double-count and "who has replied" needs no de-duplication.
model EventRsvp {
  id          String       @id @default(cuid())
  eventId     String
  userId      String
  response    RsvpResponse
  /// Anything the organisers need to know — dietary needs, arriving late.
  note        String?      @db.Text
  respondedAt DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}
