# PostgreSQL (self-hosted, e.g. via Coolify)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/volunteer_app"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="" # Generate with: npx auth secret

# Google OAuth — the web client, behind the site's "Continue with Google".
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google sign-in from the mobile app (POST /api/v1/auth/google). The iOS OAuth
# client from the SAME Google Cloud project as GOOGLE_CLIENT_ID above; the
# endpoint accepts an ID token whose audience is either id. Android needs no
# entry of its own — those tokens carry GOOGLE_CLIENT_ID, since Android's OAuth
# client is matched on package name + signing certificate and never appears in
# a token. Public identifier, not a secret — leave empty to turn mobile Google
# sign-in off (the endpoint then answers 503 and the app hides the button).
GOOGLE_IOS_CLIENT_ID=""

# Sign in with Apple from the mobile app (POST /api/v1/auth/apple). Required
# on the App Store: guideline 4.8 says an app offering Google sign-in must
# offer an equivalent, and Sign in with Apple is it.
#
# APPLE_CLIENT_ID is what appears in the token's `aud` — for a native iOS
# sign-in that's the app's bundle identifier, not a Services ID. Public
# identifier, not a secret. Comma-separate to accept more than one. Leave
# empty to turn Apple sign-in off (the endpoint answers 503 and the app hides
# the button).
APPLE_CLIENT_ID="nz.org.compassion.volunteer"

# The remaining three are the server credentials, from the Apple Developer
# portal (Keys → a key with "Sign in with Apple" enabled). They are only used
# to exchange the sign-in code for a refresh token and, when someone deletes
# their account, to revoke it.
#
# NOT OPTIONAL FOR RELEASE. Guideline 5.1.1(v) requires the app to revoke
# Apple tokens on account deletion, and without revocation someone who deletes
# their account cannot sign up with Apple again: Apple returns the email on the
# first authorisation only, so their next attempt arrives with no address and
# is refused (APPLE_NO_EMAIL). Sign-in still works without these; deletion
# logs that revocation was skipped.
APPLE_TEAM_ID=""            # 10-character team id
APPLE_KEY_ID=""             # 10-character key id for the .p8 below
# The .p8 is a multi-line PEM. Real newlines and a single line with "\n"
# escapes are both accepted, so use whichever your secret store handles - some
# flatten newlines on the way in, and a .env file needs the escaped form. To
# produce it:  awk 'BEGIN{ORS="\\n"} {print}' AuthKey_XXXXXXXXXX.p8
APPLE_PRIVATE_KEY=""

# Google Maps (address autocomplete on the application form).
# Browser-exposed — restrict the key to your domain(s) in the Google console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Email (Resend) — password reset + application notifications.
# Leave RESEND_API_KEY empty to disable sending (logged as skipped).
RESEND_API_KEY=""
EMAIL_FROM="Te Pūaroha <noreply@example.org.nz>"

# Database pool size for the single long-lived server process (default 10)
# DATABASE_POOL_MAX="10"

# One-click demo-account sign-in chips on the login page. Always on in
# `next dev`; set to "true" on non-production deploys (staging, previews)
# whose database has been seeded. NEVER set in production.
# DEMO_LOGINS="true"

# Cloudflare R2 (document + attachment storage, via its S3-compatible API).
# Endpoint is the ACCOUNT endpoint - no bucket on the end; the bucket is named
# separately below. Find it under R2 → your bucket → Settings → S3 API.
# Keys come from R2 → API → "Manage API tokens" (Object Read & Write, scoped to
# this bucket): Access Key ID → S3_ACCESS_KEY, Secret Access Key → S3_SECRET_KEY.
# Verify with `pnpm run storage:check`.
S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="volunteer-app-documents"
