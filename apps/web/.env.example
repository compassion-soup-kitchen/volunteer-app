# PostgreSQL (self-hosted, e.g. via Coolify)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/volunteer_app"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="" # Generate with: npx auth secret

# Google OAuth — the web client, behind the site's "Continue with Google".
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google sign-in from the mobile app (POST /api/v1/auth/google). These are the
# native OAuth clients from the SAME Google Cloud project; the endpoint accepts
# an ID token whose audience is any of the three ids configured here. iOS
# tokens carry the iOS client id, Android tokens carry GOOGLE_CLIENT_ID.
# Public identifiers, not secrets — leave empty to turn mobile Google sign-in
# off (the endpoint then answers 503 and the app hides the button).
GOOGLE_IOS_CLIENT_ID=""
GOOGLE_ANDROID_CLIENT_ID=""

# Google Maps (address autocomplete on the application form).
# Browser-exposed — restrict the key to your domain(s) in the Google console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Email (Resend) — password reset + application notifications.
# Leave RESEND_API_KEY empty to disable sending (logged as skipped).
RESEND_API_KEY=""
EMAIL_FROM="Te Pūaroha <noreply@example.org.nz>"

# Database pool size for the single long-lived server process (default 10)
# DATABASE_POOL_MAX="10"

# One-click demo-account sign-in chips on the login page. Always on in
# `next dev`; set to "true" on non-production deploys (staging, previews)
# whose database has been seeded. NEVER set in production.
# DEMO_LOGINS="true"

# Cloudflare R2 (document + attachment storage, via its S3-compatible API).
# Endpoint is the ACCOUNT endpoint - no bucket on the end; the bucket is named
# separately below. Find it under R2 → your bucket → Settings → S3 API.
# Keys come from R2 → API → "Manage API tokens" (Object Read & Write, scoped to
# this bucket): Access Key ID → S3_ACCESS_KEY, Secret Access Key → S3_SECRET_KEY.
# Verify with `pnpm run storage:check`.
S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="volunteer-app-documents"
