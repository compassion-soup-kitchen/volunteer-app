# PostgreSQL (self-hosted, e.g. via Coolify)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/volunteer_app"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="" # Generate with: npx auth secret

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Maps (address autocomplete on the application form).
# Browser-exposed — restrict the key to your domain(s) in the Google console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Email (Resend) — password reset + application notifications.
# Leave RESEND_API_KEY empty to disable sending (logged as skipped).
RESEND_API_KEY=""
EMAIL_FROM="Te Pūaroha <noreply@example.org.nz>"

# Database pool size for the single long-lived server process (default 10)
# DATABASE_POOL_MAX="10"

# S3-compatible storage (Garage, self-hosted via Coolify)
S3_ENDPOINT="http://localhost:3900"
S3_REGION="garage"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="documents"
