# Base URL of the web app serving the mobile API (/api/v1/*).
# Committed on purpose: this is a public URL, not a secret, and it makes the
# app talk to production out of the box in every environment.
# Override locally with .env.local (gitignored), e.g. set it empty to use the
# in-memory mock data, or to http://<your-LAN-IP>:3000 for a local backend.
EXPO_PUBLIC_API_URL=https://compassion.awhinatech.nz
