# Base URL of the web app serving the mobile API (/api/v1/*).
# The committed .env points at production. To override locally, copy this file
# to .env.local (gitignored):
#  - set it empty to run against the in-memory mock data
#  - or point it at a local backend; use your machine's LAN IP (not localhost)
#    so a device/simulator can reach it, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=https://compassion.awhinatech.nz

# Google sign-in. Both come from the same Google Cloud project as the web app's
# GOOGLE_CLIENT_ID, and both are public identifiers rather than secrets.
#  - IOS: the iOS OAuth client (bundle id nz.org.compassion.volunteer). Read at
#    build time by app.config.ts, which registers its reversed form as the
#    app's URL scheme, so changing it needs a rebuild (expo prebuild).
#  - WEB: the web ("server") OAuth client. Android needs it to be issued an ID
#    token at all; the Android OAuth client itself is matched on package name +
#    signing certificate and is never named here.
# Leave both empty to build without Google sign-in — the button is hidden.
# Google sign-in needs a development build; it cannot run in Expo Go.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
