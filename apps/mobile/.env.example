# Base URL of the web app serving the mobile API (/api/v1/*).
# The committed .env points at production. To override locally, copy this file
# to .env.local (gitignored):
#  - set it empty to run against the in-memory mock data
#  - or point it at a local backend; use your machine's LAN IP (not localhost)
#    so a device/simulator can reach it, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=https://compassion.awhinatech.nz
