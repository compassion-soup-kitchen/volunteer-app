# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Monorepo root: patterns are intentionally unanchored so they apply in every
# workspace (apps/*, packages/*), not just the root.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# turborepo
.turbo

# testing
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# next.js
.next/
out/

# expo / react native
.expo/
*.orig.*

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
