# Files excluded from the EAS Build upload archive.
#
# EAS prioritizes .easignore over .gitignore, so this MUST list everything in
# .gitignore plus anything else not needed to build the native app. The build
# server runs a fresh `pnpm install`, so dependencies and generated native
# projects are excluded here (node_modules alone is ~1.9 GB).
#
# Patterns are intentionally unanchored so they apply in every workspace.

# dependencies (reinstalled on the build server)
node_modules/
.pnp
.pnp.*
.yarn/*

# turborepo
.turbo

# testing
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# next.js (web app build output)
.next/
out/

# expo / react native
.expo/
*.orig.*

# generated native projects (regenerated by prebuild during the build)
apps/mobile/ios/
apps/mobile/android/

# production
build/
dist/

# misc
.DS_Store
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# vcs / tooling / editor (not needed for the build)
.git
.github/
.vscode/
.claude/
e2e/
